# Created for real by:  make env > .env   (then append CI_SIGNER_EMAIL — see SETUP.md).
# Example shape (two existing KCDC projects):
export PROJECT_INSECURE=my-insecure-project
export PROJECT_SECURE=my-secure-project
export REGION=us-central1
export ZONE=us-central1-a
export GSA_EMAIL=dealsvc-demo@my-secure-project.iam.gserviceaccount.com
export IMAGE_INSECURE=us-central1-docker.pkg.dev/my-insecure-project/demo/dealsvc:insecure
export IMAGE_SECURE=us-central1-docker.pkg.dev/my-secure-project/demo/dealsvc:secure
export IMAGE_POISON=us-central1-docker.pkg.dev/my-insecure-project/demo/dealsvc:poison
export IMAGE_POISON_SECURE=us-central1-docker.pkg.dev/my-secure-project/demo/dealsvc:poison
export CI_SIGNER_EMAIL=<PROJECT_NUMBER>@cloudbuild.gserviceaccount.com   # my-secure-project's Cloud Build SA

# Optional: make the swarm LLM-commanded instead of offline
# export ANTHROPIC_API_KEY=sk-ant-...
# export SWARM_MODEL=claude-3-5-haiku-latest
